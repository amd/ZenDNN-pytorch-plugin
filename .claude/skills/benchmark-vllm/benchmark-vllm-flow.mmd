%% The happy path is the linear Stage 1-5 table in SKILL.md. This diagram shows
%% only what that table cannot: the error topology -- where the flow loops back,
%% and where it must stop and tear down.
    SETUP{"harness/vllm-cpu-perf-eval present<br/>and patched?"}:::dia
    SETUP -->|"No"| CLONE["scripts/setup-harness.sh<br/>clone + git apply --3way + collection check"]:::box
    CLONE --> SETUP

    SETUP -->|"Yes"| S2["Stage 2 - hardware<br/>check_hardware.sh --mode multi --exclude nginx,guidellm --slices"]:::box
    S2 --> GFIT{"N x CPI fits the physical cores<br/>left after the nginx + guidellm bands?"}:::dia
    GFIT -->|"No"| REP["Do NOT run<br/>show the recommended N / CPI<br/>one instance per NUMA node, or the largest N that fits"]:::stop
    REP -->|"re-prompt"| S2

    GFIT -->|"Yes"| GSLICE{"check_hardware.sh emitted SLICE_i lines?"}:::dia
    GSLICE -->|"No"| WARN["WARN and fall back to contiguous arithmetic<br/>instances may straddle SMT siblings"]:::stop
    WARN --> RUN
    GSLICE -->|"Yes"| RUN["Stages 3-5, then bench.sh<br/>run_combo.sh -> run_sweep.sh -> start.sh -> ansible/GuideLLM -> stop.sh"]:::box

    RUN --> GPRE{"run_sweep.sh preflight:<br/>test_name &lt;= 30 chars, endpoint reachable,<br/>ansible collections installed?"}:::dia
    GPRE -->|"No"| STOPP["STOP before starting the stack<br/>a ~15 min warm-up wasted on a preflight failure is not recoverable"]:::stop
    GPRE -->|"Yes"| GHEALTH{"all N instances healthy<br/>within the timeout?"}:::dia

    GHEALTH -->|"No"| TEAR
    GHEALTH -->|"Yes"| GWL["per workload in -w: one GuideLLM run<br/>against the SAME warm stack"]:::box
    GWL --> GFAIL{"any step failed?<br/>non-zero exit, pull error, crash,<br/>request errors, empty result, or container OOM"}:::dia

    GFAIL -->|"Yes"| TEAR["STOP immediately, never continue to the next rate, workload or A/B leg<br/>harness/stop.sh to tear down, surface guidellm.log / results/sweep_LABEL.log<br/>likely fix: derived --max-model-len too small, lower --kv-cache-space, SKIP_HOST_CHECK=1"]:::stop
    GFAIL -->|"No"| GMORE{"more workloads left?"}:::dia
    GMORE -->|"Yes"| GWL
    GMORE -->|"No"| GAB{"native A/B asked for in Stage 3<br/>and the native leg not run yet?"}:::dia
    GAB -->|"Yes"| GNAT["re-run bench.sh --native --run-tag _native<br/>same host, same flags otherwise; first run builds LTimageGT_native"]:::box
    GNAT --> RUN
    GAB -->|"No"| DONE(["END: vllm-cpu-perf-eval/results/llm/... + results/{sweep,mem}_LABEL.*"]):::term

    classDef box fill:#dbe9f6,stroke:#6f9dc9,color:#1a1a1a
    classDef dia fill:#fdeec2,stroke:#e0b84a,color:#1a1a1a
    classDef stop fill:#f7d4d4,stroke:#d98a8a,color:#1a1a1a
    classDef term fill:#c9ecc9,stroke:#6cb56c,color:#1a1a1a
