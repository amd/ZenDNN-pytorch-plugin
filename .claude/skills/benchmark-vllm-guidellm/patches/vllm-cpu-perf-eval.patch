-- name: Fail if safety timeout is exceeded while waiting for benchmark completion (containerized)
-  ansible.builtin.fail:
-    msg: >-
-      GuideLLM benchmark did not complete before safety timeout of {{ guidellm_wait_timeout_seconds }} seconds.
+# Stop the container rather than failing outright. Failing here aborts the play
+# before main.yml can collect guidellm.log and remove the container, which leaves
+# a running load generator pinned to the loadgen cpuset that then breaks every
+# later workload in the same sweep. main.yml raises the timeout error instead.
+- name: Stop GuideLLM container after safety timeout (containerized)
+  ansible.builtin.shell:
+    cmd: "podman stop --time 30 {{ guidellm_container_name | quote }}"
+  args:
+    executable: /bin/bash
+  register: guidellm_timeout_stop
+  changed_when: false
+  failed_when: false
   when:
     - guidellm_container_running | bool
     - (guidellm_elapsed_seconds | int) >= (guidellm_wait_timeout_seconds | int)
 
+- name: Record safety timeout and end polling (containerized)
+  ansible.builtin.set_fact:
+    guidellm_safety_timeout_exceeded: true
+    guidellm_container_running: false
+  when: guidellm_timeout_stop is not skipped
+
 - name: Pause before next benchmark status check (containerized)
   ansible.builtin.pause:
     seconds: "{{ guidellm_poll_seconds }}"
